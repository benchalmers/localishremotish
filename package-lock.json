{
  "name": "remoteish-localish",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "remoteish-localish",
      "version": "1.0.0",
      "workspaces": [
        "apps/localish",
        "apps/remoteish"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "apps/localish": {
      "name": "@localish/localish",
      "version": "1.0.0",
      "bin": {
        "localish": "src/cli.js"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "apps/remoteish": {
      "name": "@localish/remoteish",
      "version": "1.0.0",
      "bin": {
        "remoteish": "src/cli.js"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/@localish/localish": {
      "resolved": "apps/localish",
      "link": true
    },
    "node_modules/@localish/remoteish": {
      "resolved": "apps/remoteish",
      "link": true
    }
  }
}
